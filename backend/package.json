{
  "name": "wuppertal-live-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute wuppertal-live --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute wuppertal-live --remote --file=./schema.sql",
    "test": "node --no-warnings test/run.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
